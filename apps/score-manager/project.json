{
  "name": "score-manager",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/score-manager/src",
  "projectType": "application",
  "tags": ["scope:score-manager"],
  "targets": {
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "node --env-file-if-exists=.env -r ts-node/register -r tsconfig-paths/register apps/score-manager/src/main.ts",
        "env": {
          "TS_NODE_PROJECT": "apps/score-manager/tsconfig.app.json",
          "TS_NODE_BASEURL": "../.."
        }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/score-manager/tsconfig.app.json --noEmit"
      }
    }
  }
}
