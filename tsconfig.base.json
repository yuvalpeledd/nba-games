{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2021",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "paths": {
      "@nba/dtos": ["./libs/dtos/common/src/index.ts"],
      "@nba/dtos-standings": ["./libs/dtos/standings/src/index.ts"],
      "@nba/dtos-teams": ["./libs/dtos/teams/src/index.ts"],
      "@nba/sql": ["./libs/sql/database/src/index.ts"],
      "@nba/sql-core": ["./libs/sql/core/src/index.ts"],
      "@nba/sql-games": ["./libs/sql/tables/games/src/index.ts"],
      "@nba/sql-games/enums": ["./libs/sql/tables/games/src/enums.ts"],
      "@nba/sql-players": ["./libs/sql/tables/players/src/index.ts"],
      "@nba/sql-seasons": ["./libs/sql/tables/seasons/src/index.ts"],
      "@nba/sql-standings": ["./libs/sql/tables/standings/src/index.ts"],
      "@nba/sql-team-players": ["./libs/sql/tables/team-players/src/index.ts"],
      "@nba/sql-teams": ["./libs/sql/tables/teams/src/index.ts"],
      "@nba/web-core": ["./libs/web/core/src/index.ts"],
      "@nba/web-dashboard-page": ["./libs/web/pages/dashboard/src/index.ts"],
      "@nba/web-design-system-components": [
        "./libs/web/components/design-system/src/index.ts"
      ],
      "@nba/web-shell-components": ["./libs/web/components/shell/src/index.ts"],
      "@nba/web-standings-page": ["./libs/web/pages/standings/src/index.ts"],
      "@nba/web-table-components": ["./libs/web/components/table/src/index.ts"],
      "@nba/web-teams-page": ["./libs/web/pages/teams/src/index.ts"],
      "@nba/web-test-utils": ["./libs/web/test-utils/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
