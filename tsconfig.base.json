{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2021",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "paths": {
      "@nba/data-fetcher-api-ninjas-client": [
        "./libs/data-fetcher/api-ninjas-client/src/index.ts"
      ],
      "@nba/data-fetcher-api-ninjas-client/fixtures": [
        "./libs/data-fetcher/api-ninjas-client/src/fixtures.ts"
      ],
      "@nba/data-fetcher-fetchers": [
        "./libs/data-fetcher/fetchers/src/index.ts"
      ],
      "@nba/sql": ["./libs/sql/database/src/index.ts"],
      "@nba/sql-core": ["./libs/sql/core/src/index.ts"],
      "@nba/sql-game-days": ["./libs/sql/tables/game-days/src/index.ts"],
      "@nba/sql-games": ["./libs/sql/tables/games/src/index.ts"],
      "@nba/sql-games/enums": ["./libs/sql/tables/games/src/enums.ts"],
      "@nba/sql-players": ["./libs/sql/tables/players/src/index.ts"],
      "@nba/sql-seasons": ["./libs/sql/tables/seasons/src/index.ts"],
      "@nba/sql-standings": ["./libs/sql/tables/standings/src/index.ts"],
      "@nba/sql-standings-history": [
        "./libs/sql/tables/standings-history/src/index.ts"
      ],
      "@nba/sql-team-players": ["./libs/sql/tables/team-players/src/index.ts"],
      "@nba/sql-teams": ["./libs/sql/tables/teams/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
